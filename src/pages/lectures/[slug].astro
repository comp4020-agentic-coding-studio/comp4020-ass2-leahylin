---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import RelatedContent from "../../components/RelatedContent.astro";
import TeachingTeam from "../../components/TeachingTeam.astro";
import { formatCourseDate } from "../../lib/dates";
import { graphCollections, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const lectures = await getPublishedCollection("lectures");
  const byWeek = [...lectures].sort((a, b) => a.data.week - b.data.week);
  return byWeek.map((lecture, index) => ({
    params: { slug: lecture.id },
    props: {
      lecture,
      prevLecture: byWeek[index - 1],
      nextLecture: byWeek[index + 1],
    },
  }));
}

const { lecture, prevLecture, nextLecture } = Astro.props;
const { Content } = await render(lecture);
const title = `Week ${lecture.data.week}: ${lecture.data.title}`;
const factsPrefix = formatCourseDate(lecture.data.date);
// Same 4-hue rotation as the lectures grid and homepage module cards, keyed
// off week rather than parsing the module string — see LecturesGrid.astro.
const moduleIndex = Math.min(4, Math.ceil(lecture.data.week / 3));

const lectureNavLinks: { href: string; label: string }[] = [];
if (prevLecture) {
  lectureNavLinks.push({
    href: withBase(`/lectures/${prevLecture.id}/`),
    label: `← Week ${prevLecture.data.week} lecture`,
  });
}
if (nextLecture) {
  lectureNavLinks.push({
    href: withBase(`/lectures/${nextLecture.id}/`),
    label: `Week ${nextLecture.data.week} lecture →`,
  });
}
---

<ContentLayout
  title={title}
  description={lecture.data.description}
  {...siteConfig}
>
  <p class="lecture-facts">
    {factsPrefix}
    {
      lecture.data.slides && (
        <>
          {" · "}
          <a href={withBase(lecture.data.slides)}>Open the slides</a>
        </>
      )
    }
  </p>
  <div class="lecture-intro" data-module={moduleIndex}>
    <Content />
  </div>
  <TeachingTeam teachers={lecture.data.teachers} />
  <RelatedContent
    entry={lecture}
    collections={graphCollections}
    extraLinks={lectureNavLinks}
  />
</ContentLayout>

<style>
  .lecture-facts {
    margin-block: 0 var(--at-spacing-lg);
    color: var(--at-text-secondary);
  }

  /* Same 4-hue rotation as LecturesGrid.astro / the homepage module cards,
     keyed off the module index computed above. */
  .lecture-intro[data-module="1"] {
    --module-color: var(--at-primary);
  }
  .lecture-intro[data-module="2"] {
    --module-color: oklch(from var(--at-primary) l c calc(h + 90));
  }
  .lecture-intro[data-module="3"] {
    --module-color: oklch(from var(--at-primary) l c calc(h + 180));
  }
  .lecture-intro[data-module="4"] {
    --module-color: oklch(from var(--at-primary) l c calc(h + 270));
  }

  /* Every week's body opens with the same "_Module N — Name..._" italic
     line (see the four-module breakdown on the lectures index). Style it as
     a callout card rather than plain italic prose — same gold-left-border
     treatment as the index pages' .at-callout--info override, applied
     directly here since this paragraph comes from Markdown, not a
     <Callout> component. Scoped styles don't reach into <Content />'s
     rendered output, hence :global() on the descendant half only.
     --module-color is set on the ancestor .lecture-intro above and
     inherits down to this child normally (unlike the card/badge case in
     LecturesGrid.astro, this is inheriting downward, so no :has() needed). */
  .lecture-intro > :global(p:first-child) {
    margin-block: 0 var(--at-spacing-lg);
    padding: var(--at-spacing-md);
    border-inline-start: 4px solid var(--module-color);
    background: light-dark(
      rgb(from var(--module-color) r g b / 8%),
      rgb(from var(--module-color) r g b / 16%)
    );
  }
</style>
