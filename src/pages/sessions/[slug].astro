---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import SpecList from "astro-course-university/components/SpecList.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import RelatedContent from "../../components/RelatedContent.astro";
import TeachingTeam from "../../components/TeachingTeam.astro";
import { formatCourseDate } from "../../lib/dates";
import { graphCollections, sessionLabels, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const sessions = await getPublishedCollection("sessions");
  const byWeek = [...sessions].sort((a, b) => a.data.week - b.data.week);
  return byWeek.map((session, index) => ({
    params: { slug: session.id },
    props: {
      session,
      prevSession: byWeek[index - 1],
      nextSession: byWeek[index + 1],
    },
  }));
}

const { session, prevSession, nextSession } = Astro.props;
const { Content } = await render(session);
// Same 4-hue rotation as LecturesGrid.astro / the homepage module cards /
// the lecture detail page, keyed off week rather than parsing a module
// string.
const moduleIndex = Math.min(4, Math.ceil(session.data.week / 3));

const sessionNavLinks: { href: string; label: string }[] = [];
if (prevSession) {
  sessionNavLinks.push({
    href: withBase(`/sessions/${prevSession.id}/`),
    label: `← Week ${prevSession.data.week} session`,
  });
}
if (nextSession) {
  sessionNavLinks.push({
    href: withBase(`/sessions/${nextSession.id}/`),
    label: `Week ${nextSession.data.week} session →`,
  });
}
---

<ContentLayout
  title={`Week ${session.data.week} ${sessionLabels.singular}: ${session.data.title}`}
  description={session.data.description}
  {...siteConfig}
>
  <p class="session-facts">
    <strong>{formatCourseDate(session.data.date)}</strong>
    {
      session.data.module && (
        <>
          {" · "}
          {session.data.module}
        </>
      )
    }
  </p>
  <hr class="session-divider" />
  <div class="session-intro" data-module={moduleIndex}>
    <Content />
  </div>
  <SpecList spec={session.data.spec}>
    What you bring to the session. Written so a reader can tell whether it has
    been met without asking you.
  </SpecList>
  <TeachingTeam teachers={session.data.teachers} />
  <RelatedContent
    entry={session}
    collections={graphCollections}
    extraLinks={sessionNavLinks}
  />
</ContentLayout>

<style>
  .session-facts {
    margin-block: 0 var(--at-spacing-md);
    color: var(--at-text-secondary);
  }

  .session-facts strong {
    color: var(--at-text);
  }

  .session-divider {
    margin-block: 0 var(--at-spacing-lg);
    /* The UA stylesheet gives <hr> `margin-inline: auto`. That's harmless in
       normal block layout (the footer's hrs fill their container), but
       .at-main is a grid and auto inline margins suppress a grid item's
       default stretch — so the hr collapsed to fit-content, i.e. 0px wide,
       and painted no line at all however dark its border colour was.
       Zeroing the inline margins lets it stretch across the content column. */
    margin-inline: 0;
    /* The theme's default --at-divider is only 12% opaque; --at-border reads
       as an actual line without being as heavy as body text. */
    border-block-start: 1px solid var(--at-border);
  }

  /* Same 4-hue rotation as LecturesGrid.astro / the homepage module cards /
     the lecture detail page, keyed off the module index computed above. */
  .session-intro[data-module="1"] {
    --module-color: var(--at-primary);
  }
  .session-intro[data-module="2"] {
    --module-color: oklch(from var(--at-primary) l c calc(h + 90));
  }
  .session-intro[data-module="3"] {
    --module-color: oklch(from var(--at-primary) l c calc(h + 180));
  }
  .session-intro[data-module="4"] {
    --module-color: oklch(from var(--at-primary) l c calc(h + 270));
  }

  /* Every session opens with a bold "This week's question" paragraph. Style
     it as a callout card rather than plain bold prose — same gold-left-border
     treatment as .lecture-intro > :global(p:first-child) in the lecture page.
     Scoped styles don't reach into <Content />'s rendered output, hence
     :global(). --module-color is set on the ancestor .session-intro above and
     inherits down to this child normally. */
  .session-intro > :global(p:first-of-type) {
    margin-block: 0 var(--at-spacing-lg);
    padding: var(--at-spacing-md);
    border-inline-start: 4px solid var(--module-color);
    background: light-dark(
      rgb(from var(--module-color) r g b / 8%),
      rgb(from var(--module-color) r g b / 16%)
    );
    font-size: 1.25rem;
    line-height: 1.4;
  }
</style>
