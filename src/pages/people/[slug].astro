---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const people = await getPublishedCollection("people");
  return people.map((person) => ({
    params: { slug: person.id },
    props: { person },
  }));
}

const { person } = Astro.props;
const { Content } = await render(person);

// Map the role enum (convenor|tutor|guest|other) to display labels rather than
// rendering the raw lowercase value.
const roleLabels: Record<string, string> = {
  convenor: "Convenor",
  "co-convenor": "Co-convenor",
  tutor: "Tutor",
  guest: "Guest lecturer",
  other: "",
};
const roleLabel = person.data.role ? roleLabels[person.data.role] : undefined;
// Astro's generated type does not retain the image/alt refinement relationship,
// so narrow the alt at the rendering boundary as well.
const rawPhotoAlt = (person.data as { photoAlt?: unknown }).photoAlt;
const photoAlt = typeof rawPhotoAlt === "string" ? rawPhotoAlt : "";
// Every page owes a description --- it is what a search result and a shared
// link show underneath the title.
const description = person.data.description;
---

<ContentLayout
  title={person.data.title}
  description={description}
  heroImage={person.data.photo ?? undefined}
  heroImageAlt={photoAlt}
  {...siteConfig}
>
  <dl class="person-meta">
    {
      roleLabel && (
        <>
          <dt>Role</dt>
          <dd>{roleLabel}</dd>
        </>
      )
    }
    {
      person.data.affiliation && (
        <>
          <dt>Affiliation</dt>
          <dd>{person.data.affiliation}</dd>
        </>
      )
    }
    {
      person.data.email && (
        <>
          <dt>Email</dt>
          <dd>
            <a href={`mailto:${person.data.email}`}>{person.data.email}</a>
          </dd>
        </>
      )
    }
    {
      person.data.url && (
        <>
          <dt>Web</dt>
          <dd>
            <a href={person.data.url}>{person.data.url}</a>
          </dd>
        </>
      )
    }
    <dt>Contact</dt>
    <dd>{person.data.contact}</dd>
  </dl>

  <Content />
</ContentLayout>

{
  /*
  The theme's hero is a ~4.4:1 full-bleed band with `object-fit: cover`, built
  for photographic art that survives a hard crop. These portraits are a centred
  object on empty ground at 16:9, so cover blew the subject up and cut the top
  and bottom off it. Switch this one page type to `contain`: the whole
  illustration sits to the right, the title takes the cream space at the left,
  and the scrim goes — it existed to keep white text legible over a photograph,
  and there is no photograph here to darken.

  Astro only ships a component's styles on the pages that render it, so
  `is:global` here reaches .at-hero without touching the home page's hero,
  which is dark art that does want the cover-and-scrim treatment.
*/
}
<style is:global>
  /* The theme's own hero rules use single-class selectors (.at-hero-title,
     etc.), so an override at that same specificity is a coin flip: whichever
     of this inline block and the theme's external stylesheet the browser
     loads later wins the tie, regardless of which one a reader sees lower on
     the page. That silently dropped the color/shadow override below in
     practice. Every selector here is compounded with its parent so it always
     outranks the theme's, independent of load order. */
  section.at-hero {
    /* Sampled from the portraits themselves, not taken from --at-bg-alt. The
       token is a near-neutral computed off the primary (oklch 96.5% L, 0.006
       C) and the illustrations sit on a warmer cream, which left a visible
       seam where the contained image met the band. A baked raster cannot
       follow a theme token, so the band matches the art instead. */
    background: #f5eede;
  }

  .at-hero .at-hero-image {
    object-fit: contain;
    object-position: right center;
    outline: none;
  }

  /* No photograph underneath, so the scrim and the white-on-dark text
     treatment both come off. */
  .at-hero .at-hero-content {
    background: none;
  }

  .at-hero-content .at-hero-title {
    /* Not `var(--at-text)`: that token is `light-dark()`, but the band above
       it is the fixed cream `#f5eede`, not a token that flips with the
       scheme. In dark mode `--at-text` resolves to a near-white value meant
       for a dark page background, which reads as barely-there grey text on
       this always-light band. Pin the light-mode reading directly instead. */
    color: oklch(from var(--at-primary) 20% 0.01 h);
    text-shadow: none;
  }

  /* Dark mode: the band goes to black and the title flips to white
     explicitly, since both are pinned to fixed light-mode values above
     rather than a light-dark() token. The portrait is dimmed so its baked
     cream doesn't sit as a bright box on black. */
  [data-theme="dark"] section.at-hero {
    background: var(--at-black);
  }

  [data-theme="dark"] .at-hero-content .at-hero-title {
    color: var(--at-white);
  }

  [data-theme="dark"] .at-hero .at-hero-image {
    filter: brightness(0.82) contrast(0.94);
  }

  /* Narrow screens: the contained image fills the width and the title would
     land on top of it, so stop overlapping and let the band be text only. */
  @media (width < 48rem) {
    .at-hero .at-hero-image {
      object-position: center top;
      opacity: 0.16;
    }
  }
</style>

<style>
  .person-meta {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--at-spacing-lg);
    row-gap: var(--at-spacing-sm);
    align-items: baseline;
    padding: var(--at-spacing-md) var(--at-spacing-lg);
    margin-block: 0 var(--at-spacing-lg);
    border: 1px solid var(--at-divider);
    background: var(--at-bg-alt);
  }

  .person-meta dt {
    font-size: var(--at-font-size-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--at-text-secondary);
  }

  .person-meta dd {
    margin: 0;
    color: var(--at-text);
  }

  @media (max-width: 30rem) {
    .person-meta {
      grid-template-columns: 1fr;
      row-gap: var(--at-spacing-xs);
    }

    .person-meta dd {
      margin-block-end: var(--at-spacing-sm);
    }
  }
</style>
