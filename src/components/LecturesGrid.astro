---
import { getPublishedCollection } from "astro-course-university/content";
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import { formatCourseDate } from "../lib/dates";

const lectures = await getPublishedCollection("lectures");
const visible = lectures.sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime(),
);

// The module index drives colour, so it comes from `week` (an exact 3-weeks-
// per-module partition) rather than from parsing the frontmatter string —
// a value that fails to parse still gets a colour instead of silently
// dropping it, the way a string-keyed lookup table could.
function moduleBadge(moduleText: string | undefined, week: number) {
  if (!moduleText) return undefined;
  const index = Math.min(4, Math.ceil(week / 3));
  if (index === 4) return { index, label: "M4·Resistance" };
  const match = moduleText.match(/^Module\s+\d+\s*[—–-]\s*(.+)$/i);
  const label = match ? `M${index} · ${match[1]}` : moduleText;
  return { index, label };
}
---

<CardGrid columns={2}>
  {
    visible.map((lecture) => {
      const badge = moduleBadge(lecture.data.module, lecture.data.week);
      return (
        <Card
          headingLevel="h2"
          title={lecture.data.title}
          href={`/lectures/${lecture.id}/`}
        >
          {lecture.data.description && <p>{lecture.data.description}</p>}
          <p class="at-card-footer">
            <small>
              Week {lecture.data.week} · {formatCourseDate(lecture.data.date)}
              {badge && (
                <>
                  {" · "}
                  <span class="at-card-badge" data-module={badge.index}>
                    {badge.label}
                  </span>
                </>
              )}
            </small>
          </p>
        </Card>
      );
    })
  }
</CardGrid>

<style>
  /* Rows in the grid stretch every card to equal height already (CSS grid
     default), but the week/date/badge line just follows the description in
     normal flow, so a shorter description leaves it higher up than its
     row-mate. Make the body a flex column and pin the footer to the bottom
     — scoped to card bodies that actually hold our badge, so this doesn't
     touch every other .at-card-body on the site (People, Sessions, etc). */
  :global(.at-card-body:has(.at-card-badge)) {
    display: flex;
    flex-direction: column;
  }

  .at-card-footer {
    margin-block-start: auto;
  }

  .at-card-badge[data-module] {
    --module-color: var(--at-primary);
  }
  .at-card-badge[data-module="2"] {
    --module-color: oklch(from var(--at-primary) l c calc(h + 90));
  }
  .at-card-badge[data-module="3"] {
    --module-color: oklch(from var(--at-primary) l c calc(h + 180));
  }
  .at-card-badge[data-module="4"] {
    --module-color: oklch(from var(--at-primary) l c calc(h + 270));
  }

  .at-card-badge[data-module] {
    background: light-dark(
      rgb(from var(--module-color) r g b / 10%),
      rgb(from var(--module-color) r g b / 18%)
    );
    border-color: light-dark(
      rgb(from var(--module-color) r g b / 45%),
      rgb(from var(--module-color) r g b / 55%)
    );
  }

  /* Custom properties don't inherit upward from the badge to its ancestor
     card, so give the card its own copy of the same 4-hue rotation — this
     is what the highlight flash below reads via var(--module-color). */
  :global(.at-card:has(.at-card-badge[data-module="1"])) {
    --module-color: var(--at-primary);
  }
  :global(.at-card:has(.at-card-badge[data-module="2"])) {
    --module-color: oklch(from var(--at-primary) l c calc(h + 90));
  }
  :global(.at-card:has(.at-card-badge[data-module="3"])) {
    --module-color: oklch(from var(--at-primary) l c calc(h + 180));
  }
  :global(.at-card:has(.at-card-badge[data-module="4"])) {
    --module-color: oklch(from var(--at-primary) l c calc(h + 270));
  }

  :global(.at-card:hover),
  :global(.at-card:focus-within) {
    background: light-dark(
      rgb(from var(--module-color) r g b / 8%),
      rgb(from var(--module-color) r g b / 16%)
    );
  }

  @keyframes at-card-flash {
    0%,
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
    25% {
      box-shadow: 0 0 0 4px var(--module-color);
    }
  }

  :global(.at-card--flash) {
    animation: at-card-flash 1.4s ease-out;
  }
</style>

<script>
  function highlightModuleFromQuery() {
    const params = new URLSearchParams(location.search);
    const raw = params.get("module");
    const index = raw ? Number(raw) : NaN;
    if (!Number.isInteger(index) || index < 1 || index > 4) return;

    const cards = document.querySelectorAll<HTMLElement>(
      `.at-card:has(.at-card-badge[data-module="${index}"])`,
    );
    if (cards.length === 0) return;

    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
    cards[0].scrollIntoView({
      behavior: reduceMotion ? "auto" : "smooth",
      block: "center",
    });

    for (const card of cards) {
      card.classList.add("at-card--flash");
      card.addEventListener(
        "animationend",
        () => card.classList.remove("at-card--flash"),
        { once: true },
      );
    }

    params.delete("module");
    const query = params.toString();
    history.replaceState(
      null,
      "",
      location.pathname + (query ? `?${query}` : "") + location.hash,
    );
  }

  highlightModuleFromQuery();
  document.addEventListener("astro:page-load", highlightModuleFromQuery);
</script>
