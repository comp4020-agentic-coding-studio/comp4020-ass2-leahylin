---
interface GradeBands {
  P: string;
  CR: string;
  D: string;
  HD: string;
}

interface WeightedMarking {
  mode: "weighted";
  criteria: { name: string; weight: number; bands?: GradeBands }[];
  note?: string[];
}

interface HolisticMarking {
  mode: "holistic";
  description: string;
}

interface Props {
  marking: WeightedMarking | HolisticMarking;
}

const { marking } = Astro.props;
const hasBands =
  marking.mode === "weighted" &&
  marking.criteria.every((criterion) => criterion.bands);
---

<section aria-labelledby="how-marked">
  <h2 id="how-marked">How it is marked</h2>
  {
    marking.mode === "holistic" ? (
      <p>{marking.description}</p>
    ) : (
      <>
        <div class="at-table-wrap">
          <table class:list={{ "marking-table--bands": hasBands }}>
            <thead>
              <tr>
                <>
                  <th scope="col">Criterion</th>
                  <th scope="col">Weight</th>
                  {hasBands && (
                    <>
                      <th scope="col">High Distinction</th>
                      <th scope="col">Distinction</th>
                      <th scope="col">Credit</th>
                      <th scope="col">Pass</th>
                    </>
                  )}
                </>
              </tr>
            </thead>
            <tbody>
              {marking.criteria.map((criterion) => (
                <tr>
                  <td>{criterion.name}</td>
                  <td>{criterion.weight}%</td>
                  {hasBands && criterion.bands && (
                    <>
                      <td>{criterion.bands.HD}</td>
                      <td>{criterion.bands.D}</td>
                      <td>{criterion.bands.CR}</td>
                      <td>{criterion.bands.P}</td>
                    </>
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {marking.note?.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </>
    )
  }
</section>

<style>
  /* The band columns hold a paragraph's worth of prose each; left at the
     theme's default auto width they compress to one or two words per line,
     which is what made this table hard to read. Give them room to breathe
     and let the wrapper (the same .at-table-wrap the theme's own markdown
     tables use for overflow) handle the horizontal scroll on narrow
     viewports instead of squeezing the text further. */
  .marking-table--bands th:nth-child(n + 3),
  .marking-table--bands td:nth-child(n + 3) {
    min-width: 14rem;
    line-height: 1.5;
  }

  /* The theme's own .at-table-wrap uses overflow-x: auto, so the scrollbar
     only appears once you start scrolling — easy to miss when the table is
     this wide. Force it always visible as a standing hint that there's more
     to see. (This element is written directly in this component, so the
     scoped selector applies only to this table's wrapper, not every
     .at-table-wrap on the site.) */
  .at-table-wrap {
    overflow-x: scroll;
  }
</style>
