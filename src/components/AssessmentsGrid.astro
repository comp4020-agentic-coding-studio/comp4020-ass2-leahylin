---
import { getPublishedCollection } from "astro-course-university/content";
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import { formatCourseDate } from "../lib/dates";

const assessments = await getPublishedCollection("assessments");
const visible = assessments.sort((a, b) => a.data.order - b.data.order);
---

<CardGrid columns={2}>
  {
    visible.map((assessment) => (
      <Card
        headingLevel="h2"
        title={assessment.data.title}
        href={`/assessments/${assessment.id}/`}
      >
        {assessment.data.description && <p>{assessment.data.description}</p>}
        {assessment.data.weight != null && (
          <p class="assessment-card-footer">
            <small>
              Due {formatCourseDate(assessment.data.due)} · Weight:{" "}
              {assessment.data.weight}%{assessment.data.draft && " · Draft"}
            </small>
          </p>
        )}
      </Card>
    ))
  }
</CardGrid>

<style>
  /* Rows in the grid stretch every card to equal height already (CSS grid
     default), but the "Due …" line just follows the description in normal
     flow, so a shorter description leaves it higher up than its row-mate.
     Make the body a flex column and pin the footer to the bottom — scoped
     to card bodies that actually hold this footer, so this doesn't touch
     every other .at-card-body on the site (People, Sessions, etc). */
  :global(.at-card-body:has(.assessment-card-footer)) {
    display: flex;
    flex-direction: column;
  }

  .assessment-card-footer {
    margin-block-start: auto;
  }
</style>
